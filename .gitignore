# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与缓存（cache/ 是可重建的转写与检测结果，属机器本地数据 §18.2）
.pytest_cache/
.coverage
htmlcov/
cache/

# 合成测试素材：体积大且可由脚本重建，不入库
# 重建命令：python tools/make_test_assets.py testdata --seconds 120
# 缺失时相关测试会跳过并给出该提示，不会静默假通过
testdata/

# 运行产物
*.part.mp4
*.stale

# 打包产物（可由 python tools/build_package.py 重建，体积 120MB+）
dist/
build/
*.spec

# 编辑器与系统
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# 模型文件体积大且可由脚本重建，不入库
models/

# 应用内安装的运行期依赖（如语音转写引擎的 wheel 解压结果，约 80 MB）
# 由「环境自检 → 安装转写引擎」按需下载，不入库
deps/

# 工作区记忆与本地配置（机器本地数据）
.workbuddy/
config.json

# 临时验证产物
.tmp-verify/

# 临时运行目录（pytest / smoke 日志、一次性对比图）
.tmp-run/

# 本地改动备份（改文件前的 .bak-YYYY-MM-DD）
*.bak-*

# 项目快照（自动保存在媒体文件旁，属用户数据不入库）
*.drama-project
